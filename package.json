{
    "name": "llm-key-manager",
    "version": "0.1.0",
    "packageManager": "pnpm@10.27.0",
    "type": "module",
    "main": "./dist/llm-key-manager.umd.js",
    "module": "./dist/llm-key-manager.es.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "import": "./dist/llm-key-manager.es.js",
            "require": "./dist/llm-key-manager.umd.js"
        }
    },
    "scripts": {
        "build:lib": "tsc && vite build",
        "build": "pnpm build:lib",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "test": "vitest run",
        "test:watch": "vitest",
        "example": "tsx examples/basic-usage.ts"
    },
    "peerDependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "dependencies": {
        "@types/uuid": "^11.0.0",
        "clsx": "^2.1.1",
        "dexie": "^4.4.3",
        "lucide-react": "^1.17.0",
        "tailwind-merge": "^3.6.0",
        "uuid": "^14.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@peculiar/webcrypto": "^1.7.1",
        "@tailwindcss/vite": "^4.3.0",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.16",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.60.1",
        "@typescript-eslint/parser": "^8.60.1",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/coverage-v8": "^4.1.8",
        "autoprefixer": "^10.5.0",
        "eslint": "^10.4.1",
        "fake-indexeddb": "^6.2.5",
        "happy-dom": "^20.10.1",
        "postcss": "^8.5.15",
        "scheduler": "0.27.0",
        "tailwindcss": "^4.3.0",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-dts": "^5.0.2",
        "vitest": "^4.1.8"
    }
}
